{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/chat",
      "dest": "/chat.html"
    },
    {
      "src": "/history",
      "dest": "/history.html"
    },
    {
      "src": "/capabilities",
      "dest": "/capabilities.html"
    },
    {
      "src": "/settings",
      "dest": "/settings.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}